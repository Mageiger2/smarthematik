        ];

        // ==========================================
        // 4. GEOGEBRA COMPONENT
        // ==========================================
        const GeoGebraViewer = ({ commands, viewport, taskKey }) => {
            const containerId = "ggb-container-" + taskKey;
            const [isLoading, setIsLoading] = useState(true);

            useEffect(() => {
                setIsLoading(true);
                const container = document.getElementById(containerId);
                if(container) container.innerHTML = '';

                const parameters = {
                    "appName": "geometry", "width": 600, "height": 320,
                    "showToolBar": false, "showAlgebraInput": false, "showMenuBar": false,
                    "enableLabelDrags": false, "enableShiftDragZoom": false, "enableRightClick": false,
                    "errorDialogsActive": false, "useBrowserForJS": false,
                    "appletOnLoad": (api) => {
                        api.setCoordSystem(viewport.xMin, viewport.xMax, viewport.yMin, viewport.yMax);
                        api.evalCommand("ShowGrid(false)");
                        api.evalCommand("ShowAxes(false)");
                        
                        commands.forEach(cmd => api.evalCommand(cmd));
                        setIsLoading(false);
                    }
                };

                const applet = new window.GGBApplet(parameters, true);
                applet.inject(containerId);

            }, [commands, viewport, taskKey]);

            return (
                <div className="flex justify-center my-4 relative w-full h-[320px] bg-white border-2 border-gray-300 rounded-lg overflow-hidden shadow-inner">
                    {isLoading && (
                        <div className="absolute inset-0 flex items-center justify-center bg-gray-50 z-10">
                            <div className="loader"></div>
                        </div>
                    )}
                    <div id={containerId} className="w-full h-full pointer-events-none"></div>
                </div>
            );
        };

        // ==========================================
        // 5. STEP COMPONENTS
        // ==========================================
        const FormulaSelection = ({ step, onCorrect, onSkip }) => {
            const [error, setError] = useState("");
            const handleSelect = (opt) => { if (opt === step.correctAnswer) { setError(""); onCorrect(); } else { setError(step.feedback); } };

            return (
                <div className="step-enter bg-white p-5 md:p-6 rounded-xl shadow-md border-l-4 border-blue-500 mb-4">
                    <h3 className="font-bold text-lg mb-4">{step.goal}</h3>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                        {step.options.map((opt, idx) => (
                            <button key={idx} onClick={() => handleSelect(opt)} className="py-3 px-4 bg-gray-50 hover:bg-blue-100 border border-gray-300 rounded-lg font-medium transition-colors math-text text-lg shadow-sm">{opt}</button>
                        ))}
                    </div>
                    <div className="flex justify-between items-center mt-2">
                        <div className="text-red-600 text-sm font-medium">{error && `💡 ${error}`}</div>
                        <button onClick={onSkip} className="text-sm text-gray-400 hover:text-gray-600 underline">Schritt überspringen ⏭</button>
                    </div>
                </div>
            );
        };

        const SubstitutionInput = ({ step, onCorrect, onSkip }) => {
            const [inputs, setInputs] = useState(Array(step.correctInputs.length).fill(""));
            const [error, setError] = useState("");

            const checkAnswer = () => {
                let isCorrect = true;
                inputs.forEach((val, idx) => { if (val.trim().toLowerCase() !== step.correctInputs[idx].toLowerCase()) isCorrect = false; });
                if (isCorrect) { setError(""); onCorrect(); } else { setError(step.feedback); }
            };

            const renderTemplate = () => {
                let inputIdx = 0;
                return step.template.split(/(\[input\d+\])/).map((part, i) => {
                    if (part.startsWith("[input")) {
                        const idx = inputIdx++;
                        return <input key={i} type="text" value={inputs[idx]} onChange={(e) => { const n = [...inputs]; n[idx] = e.target.value; setInputs(n); }} className="w-16 border-b-2 border-purple-500 bg-white mx-2 text-center font-bold text-xl outline-none focus:bg-purple-50 transition shadow-inner" />;
                    }
                    return <span key={i} className="math-text text-xl">{part}</span>;
                });
            };

            return (
                <div className="step-enter bg-white p-5 md:p-6 rounded-xl shadow-md border-l-4 border-purple-500 mb-4">
                    <h3 className="font-bold text-lg mb-4">{step.goal}</h3>
                    <div className="mb-5 py-6 bg-gray-50 rounded-lg flex flex-wrap items-center justify-center border border-gray-200">{renderTemplate()}</div>
                    <div className="flex flex-col sm:flex-row gap-3 items-center">
                        <button onClick={checkAnswer} className="w-full sm:w-auto flex-1 bg-purple-600 text-white font-bold py-3 rounded-lg hover:bg-purple-700 transition shadow">Werte prüfen</button>
                        <button onClick={onSkip} className="text-sm text-gray-500 hover:text-gray-800 bg-gray-100 py-3 px-4 rounded-lg">Schritt überspringen ⏭</button>
                    </div>
                    {error && <div className="mt-3 text-red-600 text-sm font-medium">💡 {error}</div>}
                </div>
            );
        };

        const CalculationInput = ({ step, onCorrect, onSkip }) => {
            const [val, setVal] = useState("");
            const [error, setError] = useState("");

            const checkAnswer = () => {
                const userVal = parseFloat(val.replace(',', '.'));
                const correct = parseFloat(step.correctAnswer);
                if (!isNaN(userVal) && Math.abs(userVal - correct) <= step.tolerance) { setError(""); onCorrect(); } 
                else { setError(step.feedback); }
            };

            return (
                <div className="step-enter bg-white p-5 md:p-6 rounded-xl shadow-md border-l-4 border-green-500 mb-4">
                    <h3 className="font-bold text-lg mb-4">{step.goal}</h3>
                    <div className="mb-5 py-6 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center math-text text-2xl">
                        {step.template.split("[input]")[0]}
                        <input type="text" value={val} onChange={(e) => setVal(e.target.value)} placeholder="..." className="w-24 border-2 border-green-500 rounded-lg mx-3 text-center font-bold outline-none focus:bg-green-50 p-2 shadow-inner" onKeyDown={(e) => e.key === 'Enter' && checkAnswer()} />
                        {step.template.split("[input]")[1]}
                    </div>
                    <div className="flex flex-col sm:flex-row gap-3 items-center">
                        <button onClick={checkAnswer} className="w-full sm:w-auto flex-1 bg-green-600 text-white font-bold py-3 rounded-lg hover:bg-green-700 transition shadow">Ergebnis prüfen</button>
                        <button onClick={onSkip} className="text-sm text-gray-500 hover:text-gray-800 bg-gray-100 py-3 px-4 rounded-lg">Schritt überspringen ⏭</button>
                    </div>
                    {error && <div className="mt-3 text-red-600 text-sm font-medium">💡 {error}</div>}
                </div>
            );
        };

        // ==========================================
        // 6. MAIN APP COMPONENT
        // ==========================================
        const App = () => {
            const [activeLevel, setActiveLevel] = useState(1);
            const [currentTask, setCurrentTask] = useState(null);
            const [currentStepIndex, setCurrentStepIndex] = useState(0);
            const [isCompleted, setIsCompleted] = useState(false);

            useEffect(() => { loadTaskForLevel(activeLevel); }, [activeLevel]);

            const loadTaskForLevel = (level) => {
                let newTask;
                if (level === 1) newTask = generateLevel1();
                else if (level === 2) newTask = generateLevel2();
                else if (level === 3) newTask = generateLevel3();
                else if (level === 4) {
                    let availableTasks = msaTasks.filter(t => !currentTask || t.id !== currentTask.id);
                    if(availableTasks.length === 0) availableTasks = msaTasks;
                    newTask = availableTasks[getRandomInt(0, availableTasks.length - 1)];
                }
                
                setCurrentTask(newTask);
                setCurrentStepIndex(0);
                setIsCompleted(false);
            };

            const skipTask = () => loadTaskForLevel(activeLevel);
            const handleStepCorrect = () => { if (currentStepIndex < currentTask.steps.length - 1) setCurrentStepIndex(prev => prev + 1); else setIsCompleted(true); };

            const levels = [
                { id: 1, name: "Level 1 (Leicht)" },
                { id: 2, name: "Level 2 (Mittel)" },
                { id: 3, name: "Level 3 (Schwer)" },
                { id: 4, name: "MSA Prüfungen" }
            ];

            return (
                <div className="min-h-screen flex flex-col">
                    <div className="bg-blue-900 shadow-md z-20 relative">
                        <div className="max-w-6xl mx-auto px-4 py-6">
                            <h1 className="text-3xl font-extrabold text-white mb-4">MSA Trainer: Trigonometrie & Höhensatz</h1>
                            <div className="flex flex-wrap gap-2">
                                {levels.map(level => (
                                    <button key={level.id} onClick={() => setActiveLevel(level.id)} className={`px-5 py-3 rounded-t-lg font-bold transition-all transform ${activeLevel === level.id ? 'bg-gray-100 text-blue-900 scale-105 shadow-lg border-b-0 relative top-1' : 'bg-blue-800 text-blue-200 hover:bg-blue-700'}`}>
                                        {level.id === 4 && <span className="mr-2">🔴</span>}
                                        {level.name}
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div className="flex-grow bg-gray-100 p-4 md:p-6 z-10">
                        <div className="max-w-6xl mx-auto">
                            {currentTask && (
                                <div className="grid grid-cols-1 lg:grid-cols-5 gap-8">
                                    <div className="lg:col-span-3">
                                        <div className="bg-white rounded-xl shadow-md p-6 mb-6 border-t-4 border-blue-600 relative">
                                            <button onClick={skipTask} className="absolute top-4 right-4 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-bold py-2 px-4 rounded-full flex items-center transition shadow-sm border border-gray-300">
                                                🔄 Neue Aufgabe
                                            </button>
                                            <h2 className="text-2xl font-extrabold mb-3 text-gray-800 pr-36">{currentTask.title}</h2>
                                            <p className="text-gray-700 leading-relaxed bg-blue-50 p-5 rounded-lg border border-blue-100 text-lg">
                                                {currentTask.description}
                                            </p>
                                        </div>
                                        <GeoGebraViewer commands={currentTask.ggbCommands} viewport={currentTask.viewport} taskKey={currentTask.id} />
                                    </div>

                                    <div className="lg:col-span-2">
                                        <div className="bg-white p-3 rounded-xl shadow-sm border border-gray-200 mb-4 flex justify-between items-center">
                                            <span className="font-bold text-gray-600">Dein Lösungsweg:</span>
                                            <span className="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold">Schritt {currentStepIndex + 1} / {currentTask.steps.length}</span>
                                        </div>

                                        {currentTask.steps.slice(0, currentStepIndex).map((step, idx) => (
                                            <div key={idx} className="bg-green-50 p-4 rounded-xl shadow-sm border border-green-200 mb-4 opacity-80">
                                                <div className="flex items-center text-green-700 font-bold mb-1">
                                                    <svg className="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd"></path></svg>
                                                    Schritt {idx + 1} erledigt
                                                </div>
                                                <p className="text-sm text-gray-700">{step.goal}</p>
                                            </div>
                                        ))}

                                        {!isCompleted ? (
                                            <div key={currentTask.steps[currentStepIndex].id}>
                                                {currentTask.steps[currentStepIndex].type === "formula_selection" && <FormulaSelection step={currentTask.steps[currentStepIndex]} onCorrect={handleStepCorrect} onSkip={handleStepCorrect} />}
                                                {currentTask.steps[currentStepIndex].type === "substitution" && <SubstitutionInput step={currentTask.steps[currentStepIndex]} onCorrect={handleStepCorrect} onSkip={handleStepCorrect} />}
                                                {currentTask.steps[currentStepIndex].type === "calculation" && <CalculationInput step={currentTask.steps[currentStepIndex]} onCorrect={handleStepCorrect} onSkip={handleStepCorrect} />}
                                            </div>
                                        ) : (
                                            <div className="step-enter bg-gradient-to-br from-green-500 to-green-600 text-white p-8 rounded-xl shadow-xl text-center">
                                                <span className="text-6xl block mb-4 filter drop-shadow-md">🏆</span>
                                                <h3 className="text-3xl font-extrabold mb-3">Stark gemacht!</h3>
                                                <p className="mb-8 text-green-100 text-lg">Du hast die Aufgabe erfolgreich abgeschlossen.</p>
                                                <button onClick={skipTask} className="bg-white text-green-700 font-bold py-3 px-8 rounded-full hover:bg-gray-100 shadow-lg transition-transform hover:scale-105">
                                                    Nächste Aufgabe ⏭
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
