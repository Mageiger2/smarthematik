<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSA Vorbereitung: Trigonometrie & Satzgruppe des Pythagoras</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://www.geogebra.org/apps/deployggb.js"></script>

    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f3f4f6; }
        .math-text { font-family: 'Cambria Math', 'Times New Roman', serif; font-style: italic; }
        .step-enter { animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .loader { border: 4px solid #f3f3f3; border-top: 4px solid #3b82f6; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // ==========================================
        // 1. MATHEMATISCHES KERNMODUL
        // ==========================================
        const getRandomInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;

        const generateTriangle = () => {
            const triples = [
                {a: 6, b: 8, c: 10}, {a: 9, b: 12, c: 15}, {a: 5, b: 12, c: 13}, 
                {a: 12, b: 16, c: 20}, {a: 15, b: 20, c: 25}, {a: 8, b: 15, c: 17},
                {a: 10, b: 24, c: 26}, {a: 18, b: 24, c: 30}
            ];
            
            let t = triples[getRandomInt(0, triples.length - 1)];
            if (Math.random() > 0.5) { t = {a: t.b, b: t.a, c: t.c}; } 

            const q = Number(((t.b * t.b) / t.c).toFixed(1)); 
            const p = Number(((t.a * t.a) / t.c).toFixed(1)); 
            const h = Number(((t.a * t.b) / t.c).toFixed(1)); 
            
            const alpha = Number((Math.asin(t.a / t.c) * 180 / Math.PI).toFixed(1));
            const beta = Number((Math.asin(t.b / t.c) * 180 / Math.PI).toFixed(1));

            return { ...t, p, q, h, alpha, beta };
        };

        const getViewport = (tri, mode) => {
            let neededX, neededY;
            if (mode === "standard") {
                neededX = tri.b + 4;
                neededY = tri.a + 4;
            } else {
                neededX = tri.c + 4;
                neededY = tri.h + 5;
            }
            
            let yMin = -3, xMin = -2;
            let ySpan = neededY - yMin;
            let xSpan = ySpan * (600 / 320); 
            
            if (neededX - xMin > xSpan) {
                xSpan = neededX - xMin;
                ySpan = xSpan / (600 / 320);
            }
            return { xMin, xMax: xMin + xSpan, yMin, yMax: yMin + ySpan };
        };

        const buildGGBBase = (tri, colorRGB = "30, 64, 175", mode = "standard") => {
            let cmds = [];
            if (mode === "standard") {
                cmds = [
                    `A=(0,0)`, `SetFixed(A,true)`,
                    `C=(${tri.b},0)`, `SetFixed(C,true)`,
                    `B=(${tri.b},${tri.a})`, `SetFixed(B,true)`,
                    `Poly=Polygon(A,C,B)`, `SetFilling(Poly, 0.1)`, `SetColor(Poly, ${colorRGB})`,
                    `sc=Segment(A,B)`, `sa=Segment(C,B)`, `sb=Segment(A,C)`,
                    `SetLineThickness(sc, 4)`, `SetLineThickness(sa, 4)`, `SetLineThickness(sb, 4)`,
                    `SetColor(sc, 0,0,0)`, `SetColor(sa, 0,0,0)`, `SetColor(sb, 0,0,0)`,
                    // SetAngleStyle(..., 0) zwingt GGB zu runden Winkeln anstatt Rechtecken
                    `ang90 = Angle(A,C,B)`, `SetFixed(ang90, true)`, `ShowLabel(ang90, false)`, `SetAngleStyle(ang90, 0)`
                ];
            } else {
                cmds = [
                    `A=(0,0)`, `SetFixed(A,true)`,
                    `B=(${tri.c},0)`, `SetFixed(B,true)`,
                    `C=(${tri.q},${tri.h})`, `SetFixed(C,true)`,
                    `Poly=Polygon(A,B,C)`, `SetFilling(Poly, 0.1)`, `SetColor(Poly, ${colorRGB})`,
                    `sc=Segment(A,B)`, `sa=Segment(B,C)`, `sb=Segment(C,A)`,
                    `SetLineThickness(sc, 4)`, `SetLineThickness(sa, 4)`, `SetLineThickness(sb, 4)`,
                    `SetColor(sc, 0,0,0)`, `SetColor(sa, 0,0,0)`, `SetColor(sb, 0,0,0)`,
                    `ang90 = Angle(B,C,A)`, `SetFixed(ang90, true)`, `ShowLabel(ang90, false)`, `SetAngleStyle(ang90, 0)`,
                    `D=(${tri.q},0)`, `SetFixed(D,true)`,
                    `hSeg=Segment(C,D)`, `SetLineThickness(hSeg, 4)`, `SetLineStyle(hSeg, 2)`, `SetColor(hSeg, 0,0,0)`,
                    `ang90_2 = Angle(C,D,B)`, `SetFixed(ang90_2, true)`, `ShowLabel(ang90_2, false)`, `SetAngleStyle(ang90_2, 0)`
                ];
            }
            return cmds;
        };

        // ==========================================
        // 2. AUFGABEN-GENERATOREN (Level 1 - 3)
        // ==========================================

        const generateLevel1 = () => {
            const tri = generateTriangle();
            const type = getRandomInt(1, 6);
            const id = "l1_" + Date.now();
            let title, desc, mode, ggb, steps;

            switch(type) {
                case 1: 
                    mode = "standard"; title = "Level 1: Sinus anwenden";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und der Winkel α = ${tri.alpha}°. Berechne die Gegenkathete a.`;
                    ggb = buildGGBBase(tri, "30, 64, 175", mode);
                    ggb.push(`angA=Angle(C,A,B)`, `SetCaption(angA, "${tri.alpha}°")`, `SetLabelMode(angA, 3)`, `SetAngleStyle(angA, 0)`, `Text("c = ${tri.c}", (${tri.b/2 - 1.5}, ${tri.a/2 + 0.5}))`, `Text("a = ?", (${tri.b + 0.5}, ${tri.a/2}))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["sin(α) = GK / HYP", "cos(α) = AK / HYP", "tan(α) = GK / AK"], correctAnswer: "sin(α) = GK / HYP", feedback: "Du suchst die Gegenkathete und hast die Hypotenuse." },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "sin( [input1] °) = [input2] / [input3]", correctInputs: [tri.alpha.toString(), "a", tri.c.toString()], feedback: "Winkel, gesuchte Seite, Hypotenuse." },
                        { id: 3, goal: "Berechne a.", type: "calculation", template: "a = [input] cm", correctAnswer: tri.a.toString(), tolerance: 0.2, feedback: `a = ${tri.c} · sin(${tri.alpha}°)` }
                    ]; break;
                case 2: 
                    mode = "standard"; title = "Level 1: Cosinus anwenden";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und der Winkel α = ${tri.alpha}°. Berechne die Ankathete b.`;
                    ggb = buildGGBBase(tri, "21, 128, 61", mode);
                    ggb.push(`angA=Angle(C,A,B)`, `SetCaption(angA, "${tri.alpha}°")`, `SetLabelMode(angA, 3)`, `SetAngleStyle(angA, 0)`, `Text("c = ${tri.c}", (${tri.b/2 - 1.5}, ${tri.a/2 + 0.5}))`, `Text("b = ?", (${tri.b/2}, -1))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["sin(α) = GK / HYP", "cos(α) = AK / HYP", "tan(α) = GK / AK"], correctAnswer: "cos(α) = AK / HYP", feedback: "Du suchst die Ankathete und hast die Hypotenuse." },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "cos( [input1] °) = [input2] / [input3]", correctInputs: [tri.alpha.toString(), "b", tri.c.toString()], feedback: "Winkel, gesuchte Seite, Hypotenuse." },
                        { id: 3, goal: "Berechne b.", type: "calculation", template: "b = [input] cm", correctAnswer: tri.b.toString(), tolerance: 0.2, feedback: `b = ${tri.c} · cos(${tri.alpha}°)` }
                    ]; break;
                case 3: 
                    mode = "standard"; title = "Level 1: Tangens anwenden";
                    desc = `Gegeben ist die Ankathete b = ${tri.b} cm und der Winkel α = ${tri.alpha}°. Berechne die Gegenkathete a.`;
                    ggb = buildGGBBase(tri, "202, 138, 4", mode);
                    ggb.push(`angA=Angle(C,A,B)`, `SetCaption(angA, "${tri.alpha}°")`, `SetLabelMode(angA, 3)`, `SetAngleStyle(angA, 0)`, `Text("b = ${tri.b}", (${tri.b/2}, -1))`, `Text("a = ?", (${tri.b + 0.5}, ${tri.a/2}))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["sin(α) = GK / HYP", "cos(α) = AK / HYP", "tan(α) = GK / AK"], correctAnswer: "tan(α) = GK / AK", feedback: "Ankathete ist gegeben, Gegenkathete wird gesucht." },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "tan( [input1] °) = [input2] / [input3]", correctInputs: [tri.alpha.toString(), "a", tri.b.toString()], feedback: "Winkel, Gegenkathete (a), Ankathete (b)." },
                        { id: 3, goal: "Berechne a.", type: "calculation", template: "a = [input] cm", correctAnswer: tri.a.toString(), tolerance: 0.2, feedback: `a = ${tri.b} · tan(${tri.alpha}°)` }
                    ]; break;
                case 4: 
                    mode = "standard"; title = "Level 1: Winkel berechnen";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und die Gegenkathete a = ${tri.a} cm. Berechne den Winkel α.`;
                    ggb = buildGGBBase(tri, "147, 51, 234", mode);
                    ggb.push(`angA=Angle(C,A,B)`, `SetCaption(angA, "α = ?")`, `SetLabelMode(angA, 3)`, `SetAngleStyle(angA, 0)`, `Text("c = ${tri.c}", (${tri.b/2 - 1.5}, ${tri.a/2 + 0.5}))`, `Text("a = ${tri.a}", (${tri.b + 0.5}, ${tri.a/2}))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["sin(α) = GK / HYP", "cos(α) = AK / HYP", "tan(α) = GK / AK"], correctAnswer: "sin(α) = GK / HYP", feedback: "GK und HYP sind gegeben." },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "sin( α ) = [input1] / [input2]", correctInputs: [tri.a.toString(), tri.c.toString()], feedback: "GK oben, HYP unten." },
                        { id: 3, goal: "Berechne α.", type: "calculation", template: "α = [input] °", correctAnswer: tri.alpha.toString(), tolerance: 0.5, feedback: `Nutze sin⁻¹(${tri.a}/${tri.c}).` }
                    ]; break;
                case 5: 
                    mode = "hypo_bottom"; title = "Level 1: Höhensatz";
                    desc = `Die Höhe h teilt die Hypotenuse in p = ${tri.p} cm und q = ${tri.q} cm. Berechne die Höhe h.`;
                    ggb = buildGGBBase(tri, "220, 38, 38", mode);
                    ggb.push(`Text("q = ${tri.q}", (${tri.q/2 - 0.5}, -1))`, `Text("p = ${tri.p}", (${tri.q + tri.p/2 - 0.5}, -1))`, `Text("h = ?", (${tri.q + 0.3}, ${tri.h/2}))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["h² = p · q", "a² = c · p", "b² = c · q"], correctAnswer: "h² = p · q", feedback: "Wenn p und q gegeben sind, hilft der Höhensatz." },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "h² = [input1] · [input2]", correctInputs: [tri.q.toString(), tri.p.toString()], feedback: "Setze q und p ein." },
                        { id: 3, goal: "Berechne h.", type: "calculation", template: "h = [input] cm", correctAnswer: tri.h.toString(), tolerance: 0.2, feedback: `Wurzel aus (${tri.p} · ${tri.q})` }
                    ]; break;
                case 6: 
                    mode = "hypo_bottom"; title = "Level 1: Kathetensatz";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und der Hypotenusenabschnitt p = ${tri.p} cm. Berechne die Kathete a.`;
                    ggb = buildGGBBase(tri, "225, 29, 72", mode);
                    ggb.push(`Text("c = ${tri.c}", (${tri.c/2}, -1.5))`, `Text("p = ${tri.p}", (${tri.q + tri.p/2 - 0.5}, -0.7))`, `Text("a = ?", (${tri.q + tri.p/2 + 0.5}, ${tri.h/2 + 0.5}))`);
                    steps = [
                        { id: 1, goal: "Wähle die Formel.", type: "formula_selection", options: ["h² = p · q", "a² = c · p", "b² = c · q"], correctAnswer: "a² = c · p", feedback: "Kathete a, Hypotenuse c und Abschnitt p -> Kathetensatz!" },
                        { id: 2, goal: "Werte einsetzen.", type: "substitution", template: "a² = [input1] · [input2]", correctInputs: [tri.c.toString(), tri.p.toString()], feedback: "Setze c und p ein." },
                        { id: 3, goal: "Berechne a.", type: "calculation", template: "a = [input] cm", correctAnswer: tri.a.toString(), tolerance: 0.2, feedback: `Wurzel aus (${tri.c} · ${tri.p})` }
                    ]; break;
            }
            return { id, level: 1, title, description: desc, ggbCommands: ggb, viewport: getViewport(tri, mode), steps };
        };

        const generateLevel2 = () => {
            const tri = generateTriangle();
            const type = getRandomInt(1, 3);
            const id = "l2_" + Date.now();
            let title, desc, mode, ggb, steps;

            switch(type) {
                case 1:
                    mode = "hypo_bottom"; title = "Level 2: Höhe und Kathete";
                    desc = `Gegeben sind die Hypotenusenabschnitte p = ${tri.p} cm und q = ${tri.q} cm. Berechne erst die Höhe h und danach Kathete a.`;
                    ggb = buildGGBBase(tri, "30, 64, 175", mode);
                    ggb.push(`Text("q = ${tri.q}", (${tri.q/2 - 0.5}, -1))`, `Text("p = ${tri.p}", (${tri.q + tri.p/2 - 0.5}, -1))`, `Text("h = ?", (${tri.q + 0.3}, ${tri.h/2}))`, `Text("a = ?", (${tri.q + tri.p/2 + 0.5}, ${tri.h/2 + 0.5}))`);
                    steps = [
                        { id: 1, goal: "Schritt 1: Wähle die Formel zur Berechnung der Höhe h.", type: "formula_selection", options: ["h² = p · q", "a² = c · p"], correctAnswer: "h² = p · q", feedback: "Nutze den Höhensatz!" },
                        { id: 2, goal: "Berechne h.", type: "calculation", template: "h = [input] cm", correctAnswer: tri.h.toString(), tolerance: 0.2, feedback: `h² = ${tri.p * tri.q}. Ziehe die Wurzel.` },
                        { id: 3, goal: "Schritt 2: Wähle die Formel für Kathete a.", type: "formula_selection", options: ["a² = c · p", "h² = p · q"], correctAnswer: "a² = c · p", feedback: "Nutze den Kathetensatz für a!" },
                        { id: 4, goal: `Berechne a (Hinweis: c = p+q = ${tri.c}).`, type: "calculation", template: "a = [input] cm", correctAnswer: tri.a.toString(), tolerance: 0.2, feedback: `a² = ${tri.c} · ${tri.p}. Wurzel ziehen!` }
                    ]; break;
                case 2: 
                    mode = "hypo_bottom"; title = "Level 2: Kathetensatz rückwärts";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und Kathete b = ${tri.b} cm. Berechne zuerst den Abschnitt q und danach die Höhe h.`;
                    ggb = buildGGBBase(tri, "21, 128, 61", mode);
                    ggb.push(`Text("c = ${tri.c}", (${tri.c/2}, -1.5))`, `Text("b = ${tri.b}", (${tri.q/2 - 1}, ${tri.h/2 + 0.5}))`, `Text("q = ?", (${tri.q/2 - 0.5}, -0.7))`, `Text("h = ?", (${tri.q + 0.3}, ${tri.h/2}))`);
                    steps = [
                        { id: 1, goal: "Schritt 1: Wähle die Formel, um q zu berechnen.", type: "formula_selection", options: ["b² = c · q", "h² = p · q"], correctAnswer: "b² = c · q", feedback: "Kathetensatz für b!" },
                        { id: 2, goal: "Berechne q.", type: "calculation", template: "q = [input] cm", correctAnswer: tri.q.toString(), tolerance: 0.2, feedback: `q = b² / c = ${tri.b * tri.b} / ${tri.c}` },
                        { id: 3, goal: `Schritt 2: Berechne den fehlenden Abschnitt p.`, type: "calculation", template: "p = [input] cm", correctAnswer: tri.p.toString(), tolerance: 0.2, feedback: `p = c - q = ${tri.c} - ${tri.q}` },
                        { id: 4, goal: "Berechne nun die Höhe h mit dem Höhensatz.", type: "calculation", template: "h = [input] cm", correctAnswer: tri.h.toString(), tolerance: 0.2, feedback: `h = Wurzel aus (${tri.p} · ${tri.q})` }
                    ]; break;
                case 3: 
                    mode = "standard"; title = "Level 2: Trigonometrie Mix";
                    desc = `Gegeben ist die Hypotenuse c = ${tri.c} cm und die Kathete a = ${tri.a} cm. Berechne erst den Winkel α und danach den Winkel β.`;
                    ggb = buildGGBBase(tri, "202, 138, 4", mode);
                    ggb.push(`angA=Angle(C,A,B)`, `SetCaption(angA, "α = ?")`, `SetLabelMode(angA, 3)`, `SetAngleStyle(angA, 0)`, `angB=Angle(A,B,C)`, `SetCaption(angB, "β = ?")`, `SetLabelMode(angB, 3)`, `SetAngleStyle(angB, 0)`, `Text("c = ${tri.c}", (${tri.b/2 - 1.5}, ${tri.a/2 + 0.5}))`, `Text("a = ${tri.a}", (${tri.b + 0.5}, ${tri.a/2}))`);
                    steps = [
                        { id: 1, goal: "Schritt 1: Wähle die Formel für Winkel α.", type: "formula_selection", options: ["sin(α) = a / c", "cos(α) = a / c"], correctAnswer: "sin(α) = a / c", feedback: "Gegenkathete durch Hypotenuse ist Sinus." },
                        { id: 2, goal: "Berechne α.", type: "calculation", template: "α = [input] °", correctAnswer: tri.alpha.toString(), tolerance: 0.5, feedback: `Nutze sin⁻¹(${tri.a}/${tri.c})` },
                        { id: 3, goal: "Schritt 2: Berechne Winkel β über die Winkelsumme im Dreieck (180°).", type: "calculation", template: "β = [input] °", correctAnswer: tri.beta.toString(), tolerance: 0.5, feedback: `180° - 90° - ${tri.alpha}°` }
                    ]; break;
            }
            return { id, level: 2, title, description: desc, ggbCommands: ggb, viewport: getViewport(tri, mode), steps };
        };

        const generateLevel3 = () => {
            const tri = generateTriangle();
            const id = "l3_" + Date.now();
            const mode = "hypo_bottom";
            
            const title = "Level 3: Schwer (3 Formeln kombiniert)";
            const desc = `In einem rechtwinkligen Dreieck kennst du die Höhe h = ${tri.h} cm und den Abschnitt p = ${tri.p} cm. Berechne schrittweise q, die Hypotenuse c und schließlich Kathete b.`;
            const ggb = buildGGBBase(tri, "220, 38, 38", mode);
            ggb.push(`Text("p = ${tri.p}", (${tri.q + tri.p/2 - 0.5}, -1))`, `Text("h = ${tri.h}", (${tri.q + 0.3}, ${tri.h/2}))`, `Text("q = ?", (${tri.q/2 - 0.5}, -1))`, `Text("b = ?", (${tri.q/2 - 1}, ${tri.h/2 + 0.5}))`);
            
            const steps = [
                { id: 1, goal: "Schritt 1: Wähle die Formel, um q zu berechnen.", type: "formula_selection", options: ["h² = p · q", "b² = c · q"], correctAnswer: "h² = p · q", feedback: "Nutze den Höhensatz und stelle ihn nach q um." },
                { id: 2, goal: "Berechne q.", type: "calculation", template: "q = [input] cm", correctAnswer: tri.q.toString(), tolerance: 0.2, feedback: `q = h² / p = ${tri.h * tri.h} / ${tri.p}` },
                { id: 3, goal: "Schritt 2: Berechne die gesamte Hypotenuse c.", type: "calculation", template: "c = [input] cm", correctAnswer: tri.c.toString(), tolerance: 0.2, feedback: `c = p + q` },
                { id: 4, goal: "Schritt 3: Wähle die Formel, um b zu berechnen.", type: "formula_selection", options: ["b² = c · q", "a² = c · p"], correctAnswer: "b² = c · q", feedback: "Kathetensatz für Seite b!" },
                { id: 5, goal: "Berechne b.", type: "calculation", template: "b = [input] cm", correctAnswer: tri.b.toString(), tolerance: 0.2, feedback: `b² = ${tri.c} · ${tri.q}. Wurzel ziehen.` }
            ];

            return { id, level: 3, title, description: desc, ggbCommands: ggb, viewport: getViewport(tri, mode), steps };
        };

        // ==========================================
        // 3. FESTE MSA-AUFGABEN (LEVEL 4)
        // ==========================================
        const msaTasks = [
            {
                id: "msa_2010", level: 4, title: "MSA 2010 (Verhältnis & Höhensatz)",
                description: "Im rechtwinkligen Dreieck ABC teilt die Höhe h = 10 cm die Hypotenuse im Verhältnis AD : DB = 4 : 1. Berechne die Kathete BC (a) und den Winkel α.",
                viewport: { xMin: -2, xMax: 29, yMin: -3, yMax: 13.5 },
                ggbCommands: [
                    ...buildGGBBase({c: 25, q: 20, h: 10}, "185, 28, 28", "hypo_bottom"),
                    "t1 = Text(\"h = 10\", (20.3, 5))", "t2 = Text(\"AD (q) = 4x\", (8, -1.2))", "t3 = Text(\"DB (p) = 1x\", (21, -1.2))",
                    "t4 = Text(\"a = ?\", (23, 5.5))", "angA=Angle(B,A,C)", "SetCaption(angA, \"α\")", "SetLabelMode(angA, 3)", "SetAngleStyle(angA, 0)"
                ],
                steps: [
                    { id: 1, goal: "Teil 1: Finde den Multiplikator x (h² = p·q).", type: "substitution", template: "10² = ( [input1] x ) · ( [input2] x )", correctInputs: ["4", "1"], feedback: "q ist 4x, p ist 1x." },
                    { id: 2, goal: "Berechne x.", type: "calculation", template: "x = [input]", correctAnswer: "5", tolerance: 0.1, feedback: "100 = 4x². Teile durch 4, dann Wurzel." },
                    { id: 3, goal: "Wie lang ist die gesamte Strecke AB (Hypotenuse c)?", type: "calculation", template: "c = [input] cm", correctAnswer: "25", tolerance: 0.1, feedback: "x=5, also ist p=5 und q=20. c = p + q." },
                    { id: 4, goal: "Berechne Kathete BC (Kante a).", type: "calculation", template: "a = [input] cm", correctAnswer: "11.2", tolerance: 0.2, feedback: "Kathetensatz: a² = c · p -> a² = 25 · 5 = 125." },
                    { id: 5, goal: "Berechne Winkel α im großen Dreieck ABC.", type: "calculation", template: "α = [input] °", correctAnswer: "26.6", tolerance: 0.5, feedback: "sin(α) = Gegenkathete / Hypotenuse = a / c = 11.18 / 25." }
                ]
            },
            {
                id: "msa_2025", level: 4, title: "MSA 2025 (Thaleskreis)",
